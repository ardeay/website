



	<div class="brutal-rail bg-white px-6 py-8 sm:px-10">
		<h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">Articles categorized in "{{this.name}}"</h1>
		<img src="{{this.image.getImage()}}" alt="{{this.name}} image" />
		<hr class="mt-4 border-slate-200" /> 
		<ul class="mt-6 space-y-6">
		{{each article as cat_article where z.parent_zuid = '{this.zuid}' sort by cat_article.date DESC limit 20}}
			<li class="rounded-2xl border border-slate-200 p-5 transition hover:border-slate-300 hover:shadow-sm">
				<h5 class="text-lg font-semibold text-slate-900">{{cat_article.title}}</h5>
				<h6 class="mt-1 text-sm font-medium uppercase tracking-wide text-slate-500">{{cat_article.sub_title}}</h6>
				<p class="mt-3 text-sm leading-6 text-slate-700">{{cat_article.article_body.striptags(0,130)}}... <a class="font-medium text-emerald-700 hover:text-emerald-800" href="{{cat_article.getUrl()}}">read more</a></p>
			</li>
		{{end-each}}
		</ul>
		<div class="mt-10 border-t border-slate-200 pt-6">
			<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Browse categories</h2>
			<ul class="mt-4 flex flex-wrap gap-2">
				{{each category as cat}}
					<li>
						<a class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900" href="{{cat.getURL()}}">{{cat.name}}</a>
					</li>
				{{/each}}
			</ul>
		</div>
	</div>

{{include /forms/tester.html}}
