				</main>
			</div>
		</div>

		{{include /components/footer.html}}
	</div>
</div>


<!-- studio communicator -->
<script type="text/javascript" src="/communicator.js"></script>
 
<script>
	(function () {
		function isNearBlackOrWhite(r, g, b) {
			const max = Math.max(r, g, b);
			const min = Math.min(r, g, b);
			const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b);
			if (lum < 35 || lum > 235) return true;
			if (max - min < 15 && (lum < 80 || lum > 180)) return true;
			return false;
		}

		function quantize(r, g, b, step) {
			return [
				Math.round(r / step) * step,
				Math.round(g / step) * step,
				Math.round(b / step) * step
			];
		}

		function rgbToHex(r, g, b) {
			return (
				"#" +
				[r, g, b]
					.map((v) => v.toString(16).padStart(2, "0"))
					.join("")
			);
		}

		function extractTopColors(image) {
			const canvas = document.createElement("canvas");
			const ctx = canvas.getContext("2d", { willReadFrequently: true });
			const sampleSize = 120;
			canvas.width = sampleSize;
			canvas.height = sampleSize;
			ctx.drawImage(image, 0, 0, sampleSize, sampleSize);
			const { data } = ctx.getImageData(0, 0, sampleSize, sampleSize);

			const bins = new Map();
			const step = 24;
			for (let i = 0; i < data.length; i += 4) {
				const r = data[i];
				const g = data[i + 1];
				const b = data[i + 2];
				const a = data[i + 3];
				if (a < 200) continue;
				if (isNearBlackOrWhite(r, g, b)) continue;
				const [qr, qg, qb] = quantize(r, g, b, step);
				const key = `${qr},${qg},${qb}`;
				bins.set(key, (bins.get(key) || 0) + 1);
			}

			const candidates = [...bins.entries()]
				.sort((a, b) => b[1] - a[1])
				.slice(0, 28)
				.map(([key]) => key.split(",").map((v) => Number(v)));

			return pickBalancedColors(candidates, 3);
		}

		function colorDistance(a, b) {
			const dr = a[0] - b[0];
			const dg = a[1] - b[1];
			const db = a[2] - b[2];
			return Math.sqrt(dr * dr + dg * dg + db * db);
		}

		function colorSaturation(c) {
			const max = Math.max(c[0], c[1], c[2]);
			const min = Math.min(c[0], c[1], c[2]);
			return max - min;
		}

		function pickBalancedColors(candidates, count) {
			if (!candidates || candidates.length === 0) return [];
			const pool = candidates.slice();
			const picked = [pool.slice().sort((a, b) => colorSaturation(b) - colorSaturation(a))[0]];
			while (picked.length < count && picked.length < pool.length) {
				let best = null;
				let bestScore = -Infinity;
				for (const cand of pool) {
					if (picked.includes(cand)) continue;
					const distances = picked.map((p) => colorDistance(p, cand));
					const minDist = Math.min(...distances);
					const avgDist = distances.reduce((a, b) => a + b, 0) / distances.length;
					const score = minDist * 0.45 + avgDist * 0.35 + colorSaturation(cand) * 0.2;
					if (score > bestScore) {
						bestScore = score;
						best = cand;
					}
				}
				if (!best) break;
				picked.push(best);
			}

			return picked.slice(0, count);
		}

		function applyColors(colors) {
			if (!colors || colors.length === 0) return;
			const root = document.documentElement;
			const [c1, c2, c3] = colors;
			if (c1) root.style.setProperty("--stijl-red", rgbToHex(...c1));
			if (c2) root.style.setProperty("--stijl-blue", rgbToHex(...c2));
			if (c3) root.style.setProperty("--stijl-yellow", rgbToHex(...c3));
		}

		function loadImageForAnalysis(src) {
			return new Promise((resolve, reject) => {
				const img = new Image();
				img.crossOrigin = "anonymous";
				img.onload = () => resolve(img);
				img.onerror = reject;
				img.src = src;
			});
		}

		async function getReadyImage(imgEl) {
			if (!imgEl) return null;
			if (imgEl.complete && imgEl.naturalWidth > 0) return imgEl;
			try {
				await imgEl.decode();
				return imgEl;
			} catch (err) {
				return new Promise((resolve) => {
					imgEl.addEventListener("load", () => resolve(imgEl), { once: true });
					imgEl.addEventListener("error", () => resolve(null), { once: true });
				});
			}
		}

		document.addEventListener("DOMContentLoaded", async function () {
			const firstImage = document.querySelector(".articleBody img, .article-body img, article img");
			const readyImg = await getReadyImage(firstImage);
			if (!readyImg || !readyImg.src) return;
			try {
				const img = await loadImageForAnalysis(readyImg.currentSrc || readyImg.src);
				const colors = extractTopColors(img);
				applyColors(colors);
			} catch (err) {
				// If CORS blocks canvas, do nothing and keep defaults.
			}
		});
	})();
</script>
