<style> 
	:root {
		--stijl-red: #e33a2f;
		--stijl-blue: #2455d6; 
		--stijl-yellow: #f3c22f;
		--stijl-ink: #141414;
		--stijl-paper: #f4f1ea;
		--stijl-ice: #faf9f6;
		--stijl-concrete: #d9d2c9;
	}
	.bg-stijl {
		background-color: var(--stijl-paper);
		background-image:
			linear-gradient(rgba(20, 20, 20, 0.07) 1px, transparent 1px),
			linear-gradient(90deg, rgba(20, 20, 20, 0.07) 1px, transparent 1px),
			radial-gradient(rgba(20, 20, 20, 0.08) 1px, transparent 1px);
		background-size: 24px 24px, 24px 24px, 12px 12px;
	}
	.bg-stijl-red { background-color: var(--stijl-red); }
	.bg-stijl-blue { background-color: var(--stijl-blue); }
	.bg-stijl-yellow { background-color: var(--stijl-yellow); }
	.bg-stijl-concrete { background-color: var(--stijl-concrete); }
	div[class*="bg-"] {
		transition: background-color 500ms ease;
	}
	.border-stijl-ink { border-color: var(--stijl-ink); }
	.text-stijl-ink { color: var(--stijl-ink); }
	.bg-stijl-ink {
		background: var(--stijl-ink);
	}
	.brutal-card {
		border: 3px solid var(--stijl-ink);
		box-shadow: 8px 8px 0 var(--stijl-ink);
		background: var(--stijl-ice);
	}
	.brutal-rail {
		border: 3px solid var(--stijl-ink);
		box-shadow: 6px 6px 0 var(--stijl-ink);
		background: white;
	}
	.brutal-chip {
		border: 2px solid var(--stijl-ink);
		box-shadow: 3px 3px 0 var(--stijl-ink);
		background: white;
	}
	.type-kicker {
		font-family: "Staatliches", sans-serif;
		letter-spacing: 0.24em;
		text-transform: uppercase;
	}
	.type-tight {
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.opening-description {
		position: relative;
		background: var(--stijl-ink);
		color: #f5f2ea !important;
		padding: 3.25rem 2.5rem;
		border: 3px solid var(--stijl-ink);
		box-shadow: 10px 10px 0 var(--stijl-ink);
		font-size: 4.1rem;
		line-height: 1.6;
		overflow: hidden;
	}
	.opening-description::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, transparent 0 60%, rgba(244, 241, 234, 0.06) 60% 100%),
			linear-gradient(0deg, transparent 0 70%, rgba(244, 241, 234, 0.06) 70% 100%);
		pointer-events: none;
	}
	.opening-description::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 10px;
		background: linear-gradient(90deg, var(--stijl-red) 0 45%, var(--stijl-yellow) 45% 75%, var(--stijl-blue) 75% 100%);
	}
	.page-content article {
		margin-bottom: 1.5rem;
	}
	.page-content .article-body {
		background: white;
		border: 3px solid var(--stijl-ink);
		box-shadow: 6px 6px 0 var(--stijl-ink);
		padding: 1.25rem;
	}
	.page-content .article-body p {
		line-height: 1.65;
	}
	.page-content .article-body a {
		text-decoration: none;
		border-bottom: 2px solid var(--stijl-yellow);
	}
	h1, h2, h3, h4, h5, h6 {
		font-family: "Staatliches", sans-serif;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	a {
		transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
	}
</style>

