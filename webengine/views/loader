					</nav>
					<div class="grid gap-2 text-[10px] uppercase tracking-[0.3em] text-stijl-ink/60">
						<span>Typography Studio</span>
						<span>Founded 2012</span>
					</div>
				</div>
				<div class="grid grid-cols-2 border-t-[3px] border-stijl-ink">
					<div class="h-8 bg-stijl-yellow"></div>
