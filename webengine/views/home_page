
<div class="grid gap-10">
	<div class="opening-description" itemprop="author" itemscope="" itemtype="http://schema.org/Person">
		<h6 class="text-white text-4xl uppercase tracking-[0.52em] leading-[2]" style="font-family: 'Staatliches', sans-serif;">I like to tell computers what to do. It's great when they listen.</h6>
	</div>

	<div class="grid gap-8">
		{{each article as post sort by date DESC limit 0,10}}

		{{if {index} == 1}}
		<article>
			<div class="cursor-pointer grid border-[3px] border-stijl-ink bg-white lg:grid-cols-[1fr_1.2fr]" onclick="window.location='{{post.getUrl()}}'">
				<div class="p-6">
					<div class="flex items-center gap-3 text-xs uppercase tracking-[0.28em] text-stijl-ink/70">
						<span class="h-2 w-10 bg-stijl-red"></span>
						<timestamp pubdate date="{{ post.date.date(Y-m-d) }}">{{ post.date.date(F jS, Y) }}</timestamp>
					</div>
					<h2 class="mt-4 text-3xl uppercase tracking-[0.12em]">
						<a href="{{post.getUrl()}}" title="{{post.title}} article page">{{post.title}}</a>
					</h2>
					<p class="mt-4 text-sm leading-relaxed">
						{{post.article_body.striptags(0,520)}}... <a class="border-b-2 border-stijl-yellow" href="{{post.getUrl()}}">Read Full Post</a>
					</p>
				</div> 
				<div class="min-h-[360px]">
					<img class="h-full w-full object-cover" src="{{ post.image.getImage(900,650,crop) }}" alt="{{post.title}} image" />
				</div>
			</div>
		</article>
		{{ else }}
		<article>
			<div class="cursor-pointer grid gap-0 border-[3px] border-stijl-ink bg-white md:grid-cols-[220px_1fr]" onclick="window.location='{{post.getUrl()}}'">
				<img class="h-full w-full object-cover" src="{{ post.image.getImage(300,300,crop) }}" alt="{{post.title}} image" />
				<div class="p-5">
					<div class="flex items-center gap-3 text-[10px] uppercase tracking-[0.28em] text-stijl-ink/70">
						<span class="h-2 w-8 bg-stijl-blue"></span>
						<timestamp pubdate date="{{ post.date.date(Y-m-d) }}">{{ post.date.date(F jS, Y) }}</timestamp>
					</div>
					<h3 class="mt-3 text-xl uppercase tracking-[0.1em]">
						<a href="{{post.getUrl()}}" title="{{post.title}} article page">{{post.title}}</a>
					</h3>
					<p class="mt-3 text-sm leading-relaxed">
						{{post.article_body.striptags(0,250)}}... <a class="border-b-2 border-stijl-yellow" href="{{post.getUrl()}}">Read Full Post</a>
					</p>
				</div>
			</div>
		</article>
		{{end-if}}

		{{end-each}}
	</div>
</div>
{{include /popups/tester.html}}
