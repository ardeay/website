<!-- Tag Name Header -->
<div class="brutal-card p-6 mb-2">
	<p class="type-kicker text-xs tracking-[0.3em] text-stijl-ink/50 mb-2">
		<i class="fa-solid fa-tag mr-1"></i> Tag
	</p>
	<h1 class="text-4xl font-display tracking-wider uppercase">{{this.name}}</h1>
</div>

<!-- Articles Tagged with This Tag -->
<section>
	<h2 class="type-kicker text-sm tracking-[0.3em] mb-4">
		Articles tagged &ldquo;{{this.name}}&rdquo;
	</h2>

	<div class="brutal-rail grid gap-4 p-5">
		{{each article as art where FIND_IN_SET('{this.zuid}',art.tags) sort by date DESC limit 20}}
		
		<article class="article-body flex gap-4">
			{{if {art.image} }}
			
			<div class="flex-shrink-0">
				<img src="{{art.image.getImage(100,100,crop)}}" alt="{{art.title}}" class="w-100 h-100 object-cover border-2 border-stijl-ink" />
			</div>
			{{end-if}}
			<div class="flex-1 min-w-0">
				<h3 class="text-xl font-display tracking-wider uppercase">{{art.title}}</h3>
				{{if {art.sub_title} != ""}}
				<p class="text-sm text-stijl-ink/60 mt-1">{{art.sub_title}}</p>
				{{end-if}}
				<p class="mt-3 text-sm leading-relaxed">
					{{art.article_body.striptags(0,180)}}...
					<a href="{{art.getUrl()}}" class="font-semibold border-b-2 border-stijl-ink/30 hover:border-stijl-ink">read more</a>
				</p>
			</div>
		</article>
		{{end-each}}
	</div>
</section>

<!-- All Tags -->
<section class="mt-4">
	<h2 class="type-kicker text-sm tracking-[0.3em] mb-4">All Tags</h2>
	<div class="flex flex-wrap gap-3">
		{{each tag as t sort by name ASC}}
		<a href="{{t.getUrl()}}" class="brutal-chip px-4 py-2 text-xs font-display tracking-wider uppercase transition-colors duration-200 {{if {t.zuid} == {this.zuid} }}bg-stijl-ink text-white{{end-if}}">
			<i class="fa-solid fa-tag mr-1 text-[10px]"></i>{{t.name}}
		</a>
		{{end-each}}
	</div>
</section>