<link href="//maxcdn.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css" rel="stylesheet">

<section class="brutal-card relative overflow-hidden bg-stijl-ink text-white">
	<div class="absolute inset-0 opacity-70" style="background: linear-gradient(120deg, rgba(20,20,20,0.85), rgba(20,20,20,0.6)), url({{this.header_img.getImage()}}) center/cover;"></div>
	<div class="relative z-10 px-6 py-16 sm:px-10 lg:px-14">
		<h1 class="text-5xl uppercase tracking-[0.18em]">{{this.header_title}}</h1>
		<p class="mt-4 max-w-3xl text-sm leading-relaxed text-white/90">{{this.header_desc}}</p>
		<div class="mt-8 h-2 w-full bg-gradient-to-r from-[var(--stijl-red)] via-[var(--stijl-yellow)] to-[var(--stijl-blue)]"></div>
	</div>
</section>

<section class="brutal-rail mt-6 bg-white px-6 py-4 sm:px-10 lg:px-14">
	<ol class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.28em]">
		<li>{{this.header_title}}</li>
		<li class="h-1 w-1 rounded-full bg-stijl-ink"></li>
		<li>{{clippings.site_name}}</li>
	</ol> 
</section>  

<section class="mt-8 bg-stijl-concrete/40 px-6 py-10 sm:px-10 lg:px-14" style="background-image: url('{{this.bg_img.getImage()}}'); background-size: cover; background-position: center;">
	<div class="grid gap-8 lg:grid-cols-2">
		<div class="brutal-card p-6">
			<h2 class="text-2xl uppercase tracking-[0.14em]">{{this.article_title_l}}</h2>
			<p class="mt-3 text-sm leading-relaxed">{{this.article_caption_l}}</p>
		</div>
		<div class="brutal-card p-6">
			<h2 class="text-2xl uppercase tracking-[0.14em]">{{this.article_title_r}}</h2>
			<p class="mt-3 text-sm leading-relaxed">{{this.article_caption_r}}</p>
		</div>
	</div>

	<div class="mt-12">
		<div class="brutal-rail p-6 text-center">
			<h3 class="text-xl uppercase tracking-[0.2em]">{{this.client_header}}</h3>
			<p class="mt-3 text-sm leading-relaxed">{{this.client_desc}}</p>
			<div class="mx-auto mt-4 h-2 w-20 bg-stijl-red"></div>
		</div>

		<div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
			{{each about_clients as clients sort_by sort_order ASC}}
			<div class="brutal-card overflow-hidden">
				<img class="h-[320px] w-full object-cover" src="{{clients.client_img.getImage(500,600)}}" alt="{{clients.client_name}}">
				<div class="p-5">
					<h3 class="text-lg uppercase tracking-[0.14em]">{{clients.client_name}}</h3>
					<div class="mt-3 h-1 w-10 bg-stijl-blue"></div>
					<h5 class="mt-3 text-xs uppercase tracking-[0.2em] text-stijl-ink/70">{{clients.client_haircut}}</h5>
					<div class="mt-3 h-1 w-10 bg-stijl-yellow"></div>
					<p class="mt-4 text-sm leading-relaxed">{{clients.client_desc}}</p>
					<div class="mt-5 flex gap-3 text-2xl">
						<a class="brutal-chip p-2" href="https://www.facebook.com/"><i class="fa fa-facebook-square"></i></a>
						<a class="brutal-chip p-2" href="https://twitter.com/"><i class="fa fa-twitter-square"></i></a>
						<a class="brutal-chip p-2" href="https://plus.google.com/"><i class="fa fa-google-plus-square"></i></a>
						<a class="brutal-chip p-2" href="mailto:bootsnipp@gmail.com"><i class="fa fa-envelope-square"></i></a>
					</div>
				</div>
			</div>
			{{end-each}}
		</div>
	</div>
</section>

<section class="brutal-rail mt-10 bg-white px-6 py-8 sm:px-10 lg:px-14">
	<div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
		<h3 class="text-xl uppercase tracking-[0.16em]">{{this.advertisement}}</h3>
		<button type="button" class="brutal-chip px-6 py-3 text-xs uppercase tracking-[0.24em]">{{this.button_name}}</button>
	</div>
</section>
